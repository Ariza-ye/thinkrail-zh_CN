{
	"$schema": "./typography.schema.json",
	"metadata": {
		"version": "3.1.0",
		"cssVarPrefix": "tr",
		"classPrefix": "tr"
	},
	"fontFamilies": {
		"interface": {
			"note": "Geist covers latin/latin-ext/cyrillic/vietnamese and no CJK at all, so the CJK faces after `Segoe UI` are mandatory, not decorative: without them every Chinese glyph is drawn by whatever the OS happens to fall back to. `userSelectable` makes the first entry a runtime slot — the generated var leads with `var(--tr-font-user-interface, <first entry>)`, so the app can prepend an installed family the user picked while the rest of the stack (Latin + CJK fallbacks) stays exactly as written here.",
			"stack": [
				"Geist Variable",
				"Geist",
				"-apple-system",
				"BlinkMacSystemFont",
				"Segoe UI",
				"PingFang SC",
				"Hiragino Sans GB",
				"Microsoft YaHei",
				"Noto Sans SC",
				"WenQuanYi Micro Hei",
				"sans-serif"
			],
			"kind": "proportional",
			"userSelectable": true,
			"selfHosted": ["@fontsource-variable/geist", "@fontsource-variable/geist/wght-italic.css"]
		},
		"code": {
			"stack": [
				"JetBrains Mono Variable",
				"JetBrains Mono",
				"Fira Code",
				"SF Mono",
				"Cascadia Code",
				"monospace"
			],
			"kind": "monospace",
			"selfHosted": [
				"@fontsource-variable/jetbrains-mono",
				"@fontsource-variable/jetbrains-mono/wght-italic.css"
			]
		},
		"brand": {
			"note": "Orbitron ships LATIN ONLY, and `brand.hero` renders a project's own name — so the next fallback is the interface face (Geist covers cyrillic/cyrillic-ext/latin-ext/vietnamese and is already bundled), not a system font. A non-Latin project name then falls back within our own type system instead of to whatever the OS supplies.",
			"stack": [
				"Orbitron Variable",
				"Orbitron",
				"Geist Variable",
				"Geist",
				"-apple-system",
				"BlinkMacSystemFont",
				"Segoe UI",
				"PingFang SC",
				"Microsoft YaHei",
				"Noto Sans SC",
				"sans-serif"
			],
			"kind": "proportional",
			"selfHosted": ["@fontsource-variable/orbitron"]
		}
	},
	"fontWeights": {
		"light": 370,
		"regular": 400,
		"medium": 500,
		"semibold": 600,
		"brand": 400
	},
	"fontSizes": {
		"s10": 10,
		"s11": 11,
		"s12": 12,
		"s13": 13,
		"s14": 14,
		"s16": 16,
		"s18": 18,
		"s20": 20,
		"s24": 24,
		"s44": 44
	},
	"lineHeights": {
		"compact": 1.25,
		"metadata": 1.25,
		"ui": 1.3,
		"code": 1.4,
		"relaxed": 1.4,
		"default": 1.3,
		"reading": 1.45
	},
	"letterSpacings": {
		"normal": "normal",
		"loose": "0.02em",
		"wide": "0.05em",
		"widest": "0.1em",
		"brand": "0.5px"
	},
	"rootStyle": {
		"$ref": "ui.default"
	},
	"codeRow": {
		"fontSize": "s11",
		"lineHeight": "default"
	},
	"metricOverrides": [
		{
			"selector": ":root:lang(zh)",
			"note": "Chinese metrics, applied under the interface language the app already writes to `documentElement.lang`. Geist's 370 and the dense 1.25/12px metadata were tuned to a 7.4px x-height; CJK glyphs at that weight and size read as a grey smear. 400 restores stroke contrast, s12→13px is the smallest legible CJK metadata size, and metadata keeps the body's 18.2px line box (13 × 1.4) so Chinese rows do not grow taller than the Latin ones they replace. Code sizes are untouched on purpose: the 11px code row is a whole-pixel virtualizer contract.",
			"tokens": {
				"fontWeights.light": 400,
				"fontSizes.s12": 13,
				"lineHeights.metadata": 1.4
			}
		}
	],
	"textStyles": {
		"brand": {
			"hero": {
				"fontFamily": "brand",
				"fontSize": "s44",
				"fontWeight": "brand",
				"lineHeight": "compact",
				"letterSpacing": "brand",
				"textTransform": "none",
				"fontStyle": "normal"
			}
		},
		"heading": {
			"xl": {
				"fontFamily": "interface",
				"fontSize": "s24",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"lg": {
				"fontFamily": "interface",
				"fontSize": "s20",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"md": {
				"fontFamily": "interface",
				"fontSize": "s18",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"sm": {
				"fontFamily": "interface",
				"fontSize": "s16",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			}
		},
		"title": {
			"dialog": {
				"fontFamily": "interface",
				"fontSize": "s14",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"card": {
				"$ref": "title.dialog"
			},
			"section": {
				"fontFamily": "interface",
				"fontSize": "s14",
				"fontWeight": "medium",
				"lineHeight": "default",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"compact": {
				"fontFamily": "interface",
				"fontSize": "s12",
				"fontWeight": "medium",
				"lineHeight": "default",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"entity": {
				"$ref": "body.reading"
			}
		},
		"ui": {
			"default": {
				"fontFamily": "interface",
				"fontSize": "s14",
				"fontWeight": "light",
				"lineHeight": "ui",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"metadata": {
				"fontFamily": "interface",
				"fontSize": "s12",
				"fontWeight": "light",
				"lineHeight": "metadata",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"eyebrow": {
				"fontFamily": "interface",
				"fontSize": "s12",
				"fontWeight": "medium",
				"lineHeight": "relaxed",
				"letterSpacing": "loose",
				"textTransform": "uppercase",
				"fontStyle": "normal"
			},
			"labelPill": {
				"$ref": "ui.eyebrow"
			},
			"caption": {
				"fontFamily": "interface",
				"fontSize": "s10",
				"fontWeight": "medium",
				"lineHeight": "compact",
				"letterSpacing": "wide",
				"textTransform": "uppercase",
				"fontStyle": "normal"
			},
			"action": {
				"$ref": "title.compact"
			},
			"emphasis": {
				"$ref": "title.compact"
			}
		},
		"body": {
			"reading": {
				"fontFamily": "interface",
				"fontSize": "s14",
				"fontWeight": "light",
				"lineHeight": "reading",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			}
		},
		"code": {
			"text": {
				"fontFamily": "code",
				"fontSize": "s13",
				"fontWeight": "regular",
				"lineHeight": "relaxed",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"document": {
				"fontFamily": "code",
				"fontSize": "s13",
				"fontWeight": "regular",
				"lineHeight": "code",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"otp": {
				"fontFamily": "code",
				"fontSize": "s18",
				"fontWeight": "regular",
				"lineHeight": "metadata",
				"letterSpacing": "widest",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"textSmall": {
				"fontFamily": "code",
				"fontSize": "s11",
				"fontWeight": "regular",
				"lineHeight": "code",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			}
		}
	},
	"proseSystems": {
		"chat": {
			"body": {
				"$ref": "body.reading"
			},
			"h1": {
				"$ref": "heading.md"
			},
			"h2": {
				"$ref": "title.dialog"
			},
			"h3": {
				"fontFamily": "interface",
				"fontSize": "s12",
				"fontWeight": "semibold",
				"lineHeight": "default",
				"letterSpacing": "normal",
				"textTransform": "none",
				"fontStyle": "normal"
			},
			"h4": {
				"$ref": "title.compact"
			},
			"h5": {
				"$ref": "title.compact"
			},
			"h6": {
				"fontFamily": "interface",
				"fontSize": "s10",
				"fontWeight": "medium",
				"lineHeight": "default",
				"letterSpacing": "wide",
				"textTransform": "uppercase",
				"fontStyle": "normal"
			},
			"inlineCode": {
				"$ref": "code.text"
			},
			"codeBlock": {
				"$ref": "code.text"
			},
			"blockquote": {
				"$ref": "body.reading"
			},
			"list": {
				"$ref": "body.reading"
			},
			"tableBody": {
				"$ref": "ui.metadata"
			},
			"tableHeader": {
				"$ref": "chat.h3"
			},
			"tableInlineCode": {
				"$ref": "code.textSmall"
			}
		},
		"doc": {
			"body": {
				"$ref": "body.reading"
			},
			"h1": {
				"$ref": "heading.xl"
			},
			"h2": {
				"$ref": "heading.lg"
			},
			"h3": {
				"$ref": "heading.md"
			},
			"h4": {
				"$ref": "heading.sm"
			},
			"h5": {
				"$ref": "title.dialog"
			},
			"h6": {
				"fontFamily": "interface",
				"fontSize": "s12",
				"fontWeight": "semibold",
				"lineHeight": "compact",
				"letterSpacing": "wide",
				"textTransform": "uppercase",
				"fontStyle": "normal"
			},
			"inlineCode": {
				"$ref": "code.text"
			},
			"codeBlock": {
				"$ref": "code.document"
			},
			"blockquote": {
				"$ref": "body.reading"
			},
			"list": {
				"$ref": "body.reading"
			},
			"tableBody": {
				"$ref": "body.reading"
			},
			"tableHeader": {
				"$ref": "title.dialog"
			},
			"tableInlineCode": {
				"$ref": "code.text"
			}
		}
	}
}
